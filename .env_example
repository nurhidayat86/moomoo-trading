# moomoo OpenD connection (copy to .env and adjust)
OPEND_HOST=127.0.0.1
OPEND_PORT=11111

# PKCS#1 RSA private key for API protocol encryption (must match OpenD config)
RSA_PRIVATE_KEY_PATH=~/.ssh/rsa_private_key.pem

# Set to false to connect without protocol encryption (only if OpenD allows it)
OPEND_ENABLE_ENCRYPT=true

# Trading defaults for portfolio scripts
FUTU_TRD_ENV=SIMULATE
# FUTU_ACC_ID=1879306
# FUTU_SECURITY_FIRM=FUTUINC
