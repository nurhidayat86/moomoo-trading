symbols:
  - US.AAPL

collector:
  extended_time: true
  session: ALL
  queue_maxsize: 100000
  writer_batch_size: 1000
  writer_flush_interval_sec: 0.25
  ticker_rotate_minutes: 15
  orderbook_rotate_minutes: 5
  sqlite_checkpoint_interval_sec: 30
  reconnect_initial_sec: 1
  reconnect_max_sec: 60
  is_first_push: true
  ticks_sqlite_retention_hours: 48
  orderbook_sqlite_retention_hours: 24
  health_interval_sec: 60
  shutdown_drain_timeout_sec: 30

paths:
  data_root: data

logging:
  level: INFO
  json: false
